# Copy to .env and fill in real values: cp .env.example .env

# MongoDB root user (created when the mongo volume is first initialised)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me

# Used when running the API outside Docker (docker-compose builds its own URI)
MONGO_URI=mongodb://root:change-me@localhost:27017/?authSource=admin
MONGO_DB=ojas_ocean_edge

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First app admin, created on startup if no admin exists (must change password on first login)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-please
