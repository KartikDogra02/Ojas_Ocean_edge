# Copy to .env and fill in real values: cp .env.example .env

# MongoDB root user (created when the mongo volume is first initialised)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me

# Used when running the API outside Docker (docker-compose builds its own URI)
MONGO_URI=mongodb://root:change-me@localhost:27017/?authSource=admin
MONGO_DB=ojas_ocean_edge

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origins allowed to call the API from a browser (comma-separated, exact origins) can be changed depending on the dev enviroment
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File storage for receipts and signatures: "gridfs" (inside MongoDB, default) or "r2" (Cloudflare R2).
# For R2: create a private bucket and an R2 API token with Object Read & Write on that bucket only.
STORAGE_BACKEND=gridfs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional endpoint override, e.g. http://s3:8333 for the local SeaweedFS in docker-compose (profile "s3")
R2_ENDPOINT=

# First app admin, created on startup if no admin exists (must change password on first login)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-please
